@inproceedings{shindo_image_2024,
	address = {Abu Dhabi, United Arab Emirates},
	title = {Image {Coding} {For} {Machines} {With} {Edge} {Information} {Learning} {Using} {Segment} {Anything}},
	copyright = {https://doi.org/10.15223/policy-029},
